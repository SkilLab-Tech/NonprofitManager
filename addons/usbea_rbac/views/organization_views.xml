<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- Organization / Workspace Management          -->
    <!-- (extends res.company)                        -->
    <!-- ============================================ -->

    <!-- Organization Form View -->
    <record id="view_organization_form" model="ir.ui.view">
        <field name="name">res.company.organization.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add stat buttons -->
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="org_button_box">
                    <button name="action_view_members" type="object"
                            class="oe_stat_button" icon="fa-users"
                            groups="usbea_rbac.group_platform_org_admin">
                        <field name="member_count" widget="statinfo"
                               string="Members"/>
                    </button>
                    <button name="action_view_invitations" type="object"
                            class="oe_stat_button" icon="fa-envelope"
                            groups="usbea_rbac.group_platform_org_admin">
                        <field name="invitation_count" widget="statinfo"
                               string="Invitations"/>
                    </button>
                </div>
            </xpath>

            <!-- Add organization fields after the main company fields -->
            <xpath expr="//field[@name='name']/.." position="after">
                <group string="Organization Details"
                       groups="usbea_rbac.group_platform_org_admin">
                    <group>
                        <field name="organization_type"/>
                        <field name="organization_size"/>
                        <field name="founded_year"/>
                        <field name="tax_id_number"/>
                        <field name="registration_number"/>
                    </group>
                    <group>
                        <field name="subscription_status"
                               groups="usbea_rbac.group_platform_super_admin"/>
                        <field name="subscription_plan"
                               groups="usbea_rbac.group_platform_super_admin"/>
                        <field name="trial_end_date"
                               invisible="subscription_status != 'trial'"
                               groups="usbea_rbac.group_platform_super_admin"/>
                        <field name="is_platform_root"
                               groups="usbea_rbac.group_platform_super_admin"/>
                        <field name="created_by_super_admin"
                               groups="usbea_rbac.group_platform_super_admin"/>
                    </group>
                </group>
                <group string="Public Profile"
                       groups="usbea_rbac.group_platform_org_admin">
                    <group>
                        <field name="mission_statement"/>
                    </group>
                    <group>
                        <field name="support_email"/>
                        <field name="public_phone"/>
                        <field name="public_website" widget="url"/>
                    </group>
                </group>
                <group string="Social Media"
                       groups="usbea_rbac.group_platform_org_admin">
                    <group>
                        <field name="social_facebook" widget="url"/>
                        <field name="social_instagram" widget="url"/>
                        <field name="social_linkedin" widget="url"/>
                    </group>
                    <group>
                        <field name="social_twitter" widget="url"/>
                        <field name="social_youtube" widget="url"/>
                    </group>
                </group>
                <group string="About" groups="usbea_rbac.group_platform_org_admin">
                    <field name="organization_description" nolabel="1"
                           placeholder="Describe your organization..."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Super Admin: List of all organizations -->
    <record id="view_organization_list" model="ir.ui.view">
        <field name="name">res.company.organization.list</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list string="Organizations"
                  decoration-muted="subscription_status in ('suspended', 'cancelled')"
                  decoration-warning="subscription_status == 'trial'">
                <field name="name"/>
                <field name="organization_type"/>
                <field name="subscription_status" widget="badge"
                       decoration-success="subscription_status == 'active'"
                       decoration-warning="subscription_status == 'trial'"
                       decoration-danger="subscription_status in ('suspended', 'cancelled')"/>
                <field name="subscription_plan"/>
                <field name="member_count"/>
                <field name="support_email"/>
                <field name="public_website" widget="url"/>
                <field name="created_by_super_admin"/>
            </list>
        </field>
    </record>

    <!-- Super Admin: Organization Kanban -->
    <record id="view_organization_kanban" model="ir.ui.view">
        <field name="name">res.company.organization.kanban</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="organization_type"/>
                <field name="subscription_status"/>
                <field name="subscription_plan"/>
                <field name="member_count"/>
                <field name="logo_web"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="me-2">
                                <field name="logo_web" widget="image"
                                       options="{'size': [60, 60]}"/>
                            </div>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted">
                                    <field name="organization_type"/>
                                </div>
                                <div>
                                    <field name="subscription_status" widget="badge"/>
                                    <field name="subscription_plan" widget="badge"/>
                                </div>
                                <div class="mt-1">
                                    <strong><field name="member_count"/></strong> members
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Organization Search -->
    <record id="view_organization_search" model="ir.ui.view">
        <field name="name">res.company.organization.search</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <search string="Search Organizations">
                <field name="name"/>
                <field name="support_email"/>
                <filter string="Active" name="active"
                        domain="[('subscription_status', '=', 'active')]"/>
                <filter string="Trial" name="trial"
                        domain="[('subscription_status', '=', 'trial')]"/>
                <filter string="Suspended" name="suspended"
                        domain="[('subscription_status', '=', 'suspended')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'organization_type'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'subscription_status'}"/>
                    <filter string="Plan" name="group_plan"
                            context="{'group_by': 'subscription_plan'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Super Admin: Manage all organizations action -->
    <record id="action_manage_organizations" model="ir.actions.act_window">
        <field name="name">Organizations</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_organization_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_organization_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_organization_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new organization
            </p>
            <p>
                Organizations are isolated workspaces with their own data,
                users, and settings.
            </p>
        </field>
    </record>
</odoo>
