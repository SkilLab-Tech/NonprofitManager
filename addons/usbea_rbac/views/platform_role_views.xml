<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Role Form View -->
    <record id="view_platform_role_form" model="ir.ui.view">
        <field name="name">usbea.platform.role.form</field>
        <field name="model">usbea.platform.role</field>
        <field name="arch" type="xml">
            <form string="Custom Role">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Grants Manager"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="organization_id"
                                   groups="usbea_rbac.group_platform_super_admin"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="user_count"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Describe what this role can do..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Permissions" name="permissions">
                            <group>
                                <group string="Grant Management">
                                    <field name="can_manage_grants"/>
                                    <field name="can_manage_expenses"/>
                                    <field name="can_approve_expenses"/>
                                    <field name="can_view_financials"/>
                                    <field name="can_manage_reports"/>
                                </group>
                                <group string="Programs &amp; Operations">
                                    <field name="can_manage_programs"/>
                                    <field name="can_manage_participants"/>
                                    <field name="can_manage_events"/>
                                </group>
                            </group>
                            <group>
                                <group string="General">
                                    <field name="can_view_dashboard"/>
                                    <field name="can_export_data"/>
                                </group>
                            </group>
                        </page>
                        <page string="Assigned Users" name="users">
                            <field name="user_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="platform_role"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Custom Role List View -->
    <record id="view_platform_role_list" model="ir.ui.view">
        <field name="name">usbea.platform.role.list</field>
        <field name="model">usbea.platform.role</field>
        <field name="arch" type="xml">
            <list string="Custom Roles">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="organization_id"
                       groups="usbea_rbac.group_platform_super_admin"/>
                <field name="user_count"/>
                <field name="can_manage_grants"/>
                <field name="can_manage_programs"/>
                <field name="can_manage_expenses"/>
                <field name="can_view_financials"/>
                <field name="can_view_dashboard"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Custom Role Action -->
    <record id="action_platform_roles" model="ir.actions.act_window">
        <field name="name">Custom Roles</field>
        <field name="res_model">usbea.platform.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a custom role
            </p>
            <p>
                Define custom roles with specific permission sets for your
                organization. Assign users to roles for granular access control.
            </p>
        </field>
    </record>
</odoo>
