<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups (category defined in usbea_rbac) -->
    <record id="group_grant_user" model="res.groups">
        <field name="name">Grant User</field>
        <field name="category_id" ref="usbea_rbac.module_category_usbea"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_grant_manager" model="res.groups">
        <field name="name">Grant Manager</field>
        <field name="category_id" ref="usbea_rbac.module_category_usbea"/>
        <field name="implied_ids" eval="[(4, ref('usbea_grants.group_grant_user'))]"/>
    </record>

    <record id="group_grant_admin" model="res.groups">
        <field name="name">Grant Administrator</field>
        <field name="category_id" ref="usbea_rbac.module_category_usbea"/>
        <field name="implied_ids" eval="[(4, ref('usbea_grants.group_grant_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_board_member" model="res.groups">
        <field name="name">Board Member (Read-Only)</field>
        <field name="category_id" ref="usbea_rbac.module_category_usbea"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Record Rules -->

    <!-- Grant users can see all grants -->
    <record id="grant_rule_user" model="ir.rule">
        <field name="name">Grant: User sees all</field>
        <field name="model_id" ref="model_usbea_grant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_grant_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Grant managers can create/edit grants -->
    <record id="grant_rule_manager" model="ir.rule">
        <field name="name">Grant: Manager full access</field>
        <field name="model_id" ref="model_usbea_grant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_grant_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Board members read-only access to grants -->
    <record id="grant_rule_board" model="ir.rule">
        <field name="name">Grant: Board read-only</field>
        <field name="model_id" ref="model_usbea_grant"/>
        <field name="domain_force">[('state', 'not in', ['draft'])]</field>
        <field name="groups" eval="[(4, ref('group_board_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
