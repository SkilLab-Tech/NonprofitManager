<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grant Portfolio Report Action -->
    <record id="action_report_grant_portfolio" model="ir.actions.report">
        <field name="name">Grant Portfolio Overview</field>
        <field name="model">usbea.grant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">usbea_grants.report_grant_portfolio</field>
        <field name="report_file">usbea_grants.report_grant_portfolio</field>
        <field name="binding_model_id" ref="model_usbea_grant"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Grant Portfolio PDF Template -->
    <template id="report_grant_portfolio">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="grant">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Grant Portfolio Report</h2>
                        <h3><t t-out="grant.name"/></h3>
                        <p><strong>Grant Number:</strong> <t t-out="grant.grant_number"/></p>
                        <p><strong>Status:</strong> <t t-out="dict(grant._fields['state'].selection).get(grant.state)"/></p>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Field</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Funding Organization</td>
                                    <td><t t-out="grant.funding_source.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Grant Type</td>
                                    <td><t t-out="dict(grant._fields['grant_type'].selection).get(grant.grant_type)"/></td>
                                </tr>
                                <tr>
                                    <td>Grant Manager</td>
                                    <td><t t-out="grant.responsible_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>Start Date</td>
                                    <td><t t-out="grant.start_date or '-'"/></td>
                                </tr>
                                <tr>
                                    <td>End Date</td>
                                    <td><t t-out="grant.end_date or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Financial Summary</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>Requested Amount</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.requested_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Approved Amount</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.approved_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Disbursed Amount</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.disbursed_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Spent Amount</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.spent_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Remaining</td>
                                    <td class="text-end">
                                        <t t-out="grant.remaining_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Utilization</strong></td>
                                    <td class="text-end">
                                        <t t-out="'%.1f' % grant.utilization_rate"/>%
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Budget Breakdown -->
                        <t t-if="grant.budget_ids">
                            <h4 class="mt-4">Budget Breakdown</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Planned</th>
                                        <th class="text-end">Actual</th>
                                        <th class="text-end">Variance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="grant.budget_ids" t-as="budget">
                                        <tr>
                                            <td><t t-out="budget.name"/></td>
                                            <td class="text-end">
                                                <t t-out="budget.planned_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.actual_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.variance"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Compliance -->
                        <t t-if="grant.reporting_deadline">
                            <h4 class="mt-4">Compliance</h4>
                            <p><strong>Reporting Frequency:</strong>
                                <t t-out="dict(grant._fields['reporting_frequency'].selection).get(grant.reporting_frequency) if grant.reporting_frequency else '-'"/>
                            </p>
                            <p><strong>Next Report Due:</strong>
                                <t t-out="grant.reporting_deadline"/>
                            </p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
