<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_measurement_list" model="ir.ui.view">
        <field name="name">usbea.impact.measurement.list</field>
        <field name="model">usbea.impact.measurement</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="indicator_id"/>
                <field name="value"/>
                <field name="source"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="action_measurement" model="ir.actions.act_window">
        <field name="name">Measurements</field>
        <field name="res_model">usbea.impact.measurement</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
