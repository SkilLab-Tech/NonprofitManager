<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Board Dashboard: Active Grants (read-only) -->
    <record id="view_board_grant_list" model="ir.ui.view">
        <field name="name">usbea.grant.board.list</field>
        <field name="model">usbea.grant</field>
        <field name="arch" type="xml">
            <list string="Grant Portfolio" create="0" edit="0" delete="0"
                  decoration-success="state == 'completed'"
                  decoration-muted="state in ('rejected', 'cancelled')">
                <field name="grant_number"/>
                <field name="name"/>
                <field name="funding_source"/>
                <field name="grant_type"/>
                <field name="approved_amount" sum="Total Approved"/>
                <field name="disbursed_amount" sum="Total Disbursed"/>
                <field name="spent_amount" sum="Total Spent"/>
                <field name="remaining_amount" sum="Total Remaining"/>
                <field name="utilization_rate" widget="progressbar"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="reporting_deadline"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'submitted')"
                       decoration-warning="state in ('under_review', 'reporting')"
                       decoration-success="state in ('approved', 'active', 'completed')"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Board Dashboard: Grant Kanban (read-only) -->
    <record id="view_board_grant_kanban" model="ir.ui.view">
        <field name="name">usbea.grant.board.kanban</field>
        <field name="model">usbea.grant</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="grant_number"/>
                <field name="funding_source"/>
                <field name="approved_amount"/>
                <field name="spent_amount"/>
                <field name="remaining_amount"/>
                <field name="utilization_rate"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <strong><field name="name"/></strong>
                        <div class="text-muted"><field name="grant_number"/></div>
                        <div><field name="funding_source"/></div>
                        <div class="mt-2">
                            <strong>Approved: </strong>
                            <field name="approved_amount" widget="monetary"/>
                        </div>
                        <div>
                            <strong>Spent: </strong>
                            <field name="spent_amount" widget="monetary"/>
                        </div>
                        <div>
                            <strong>Remaining: </strong>
                            <field name="remaining_amount" widget="monetary"/>
                        </div>
                        <div class="mt-2">
                            <field name="utilization_rate" widget="progressbar"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Board Dashboard: Grant Pivot -->
    <record id="view_board_grant_pivot" model="ir.ui.view">
        <field name="name">usbea.grant.board.pivot</field>
        <field name="model">usbea.grant</field>
        <field name="arch" type="xml">
            <pivot string="Financial Overview">
                <field name="funding_source" type="row"/>
                <field name="state" type="col"/>
                <field name="approved_amount" type="measure"/>
                <field name="spent_amount" type="measure"/>
                <field name="remaining_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Board Dashboard: Grant Graph -->
    <record id="view_board_grant_graph" model="ir.ui.view">
        <field name="name">usbea.grant.board.graph</field>
        <field name="model">usbea.grant</field>
        <field name="arch" type="xml">
            <graph string="Budget vs Spending" type="bar">
                <field name="name"/>
                <field name="approved_amount" type="measure"/>
                <field name="spent_amount" type="measure"/>
                <field name="remaining_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Board Dashboard: Search View -->
    <record id="view_board_grant_search" model="ir.ui.view">
        <field name="name">usbea.grant.board.search</field>
        <field name="model">usbea.grant</field>
        <field name="arch" type="xml">
            <search string="Search Grants">
                <field name="name"/>
                <field name="funding_source"/>
                <filter string="Active Grants" name="active_grants"
                        domain="[('state', 'in', ('active', 'reporting'))]"/>
                <filter string="All Funded" name="funded"
                        domain="[('state', 'not in', ('draft', 'rejected', 'cancelled'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Grant Type" name="group_type"
                            context="{'group_by': 'grant_type'}"/>
                    <filter string="Funder" name="group_funder"
                            context="{'group_by': 'funding_source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Board Dashboard Action: Grant Portfolio -->
    <record id="action_board_grant_portfolio" model="ir.actions.act_window">
        <field name="name">Grant Portfolio</field>
        <field name="res_model">usbea.grant</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="search_view_id" ref="view_board_grant_search"/>
        <field name="context">{'search_default_active_grants': 1, 'create': 0, 'edit': 0, 'delete': 0}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_board_grant_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_board_grant_kanban')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_board_grant_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_board_grant_graph')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active grants
            </p>
            <p>
                Grant portfolio overview for board review.
            </p>
        </field>
    </record>

    <!-- Board Dashboard Action: Financial Summary (Pivot) -->
    <record id="action_board_financial_summary" model="ir.actions.act_window">
        <field name="name">Financial Summary</field>
        <field name="res_model">usbea.grant</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_board_grant_search"/>
        <field name="context">{'search_default_funded': 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_board_grant_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_board_grant_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_board_grant_list')}),
        ]"/>
    </record>

    <!-- Board Dashboard Action: Programs Overview (read-only) -->
    <record id="view_board_program_list" model="ir.ui.view">
        <field name="name">usbea.program.board.list</field>
        <field name="model">usbea.program</field>
        <field name="arch" type="xml">
            <list string="Programs Overview" create="0" edit="0" delete="0"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="program_code"/>
                <field name="name"/>
                <field name="program_type"/>
                <field name="participant_count"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="budget"/>
                <field name="responsible_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('planning', 'recruiting')"
                       decoration-success="state in ('active', 'completed')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="action_board_programs" model="ir.actions.act_window">
        <field name="name">Programs Overview</field>
        <field name="res_model">usbea.program</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_board_program_list')}),
        ]"/>
    </record>

    <!-- Board Dashboard Action: Compliance Calendar -->
    <record id="action_board_compliance_calendar" model="ir.actions.act_window">
        <field name="name">Compliance Calendar</field>
        <field name="res_model">usbea.grant.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
        <field name="domain">[('state', 'not in', ['accepted'])]</field>
    </record>
</odoo>
