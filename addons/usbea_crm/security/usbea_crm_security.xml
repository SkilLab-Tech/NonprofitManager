<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_usbea_crm" model="ir.module.category">
            <field name="name">USBEA CRM</field>
            <field name="sequence">75</field>
        </record>

        <record id="group_usbea_crm_user" model="res.groups">
            <field name="name">USBEA CRM / User</field>
            <field name="category_id" ref="module_category_usbea_crm"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_usbea_crm_manager" model="res.groups">
            <field name="name">USBEA CRM / Manager</field>
            <field name="category_id" ref="module_category_usbea_crm"/>
            <field name="implied_ids" eval="[(4, ref('group_usbea_crm_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <record id="rule_cultivation_move_company" model="ir.rule">
            <field name="name">Cultivation move: company-scoped</field>
            <field name="model_id" ref="model_usbea_cultivation_move"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_engagement_event_company" model="ir.rule">
            <field name="name">Engagement event: company-scoped</field>
            <field name="model_id" ref="model_usbea_engagement_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
