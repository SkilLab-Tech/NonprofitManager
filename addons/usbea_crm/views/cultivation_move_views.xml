<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cultivation_move_list" model="ir.ui.view">
        <field name="name">usbea.cultivation.move.list</field>
        <field name="model">usbea.cultivation.move</field>
        <field name="arch" type="xml">
            <list>
                <field name="occurred_on"/>
                <field name="partner_id"/>
                <field name="move_type"/>
                <field name="summary"/>
                <field name="amount_discussed"/>
                <field name="currency_id" invisible="1"/>
                <field name="moved_to_stage"/>
                <field name="next_move_due"/>
                <field name="assigned_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_cultivation_move_kanban" model="ir.ui.view">
        <field name="name">usbea.cultivation.move.kanban</field>
        <field name="model">usbea.cultivation.move</field>
        <field name="arch" type="xml">
            <kanban default_group_by="moved_to_stage">
                <field name="partner_id"/>
                <field name="summary"/>
                <field name="amount_discussed"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="partner_id"/></strong>
                            <div><field name="summary"/></div>
                            <div><field name="amount_discussed"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cultivation_move_form" model="ir.ui.view">
        <field name="name">usbea.cultivation.move.form</field>
        <field name="model">usbea.cultivation.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="move_type"/>
                            <field name="occurred_on"/>
                            <field name="moved_to_stage"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="next_move_due"/>
                            <field name="amount_discussed"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="summary" placeholder="Short summary..."/>
                    <field name="outcome" placeholder="What happened, what's next..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_cultivation_move" model="ir.actions.act_window">
        <field name="name">Cultivation Moves</field>
        <field name="res_model">usbea.cultivation.move</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
