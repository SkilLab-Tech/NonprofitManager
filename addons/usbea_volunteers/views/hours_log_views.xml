<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hours_log_list" model="ir.ui.view">
        <field name="name">usbea.volunteer.hours_log.list</field>
        <field name="model">usbea.volunteer.hours_log</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-muted="state == 'rejected'">
                <field name="served_on"/>
                <field name="partner_id"/>
                <field name="program_id"/>
                <field name="hours"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hours_log_form" model="ir.ui.view">
        <field name="name">usbea.volunteer.hours_log.form</field>
        <field name="model">usbea.volunteer.hours_log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state == 'approved'" groups="usbea_volunteers.group_volunteers_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state in ('approved', 'rejected')" groups="usbea_volunteers.group_volunteers_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="program_id"/>
                            <field name="opportunity_id"/>
                        </group>
                        <group>
                            <field name="served_on"/>
                            <field name="hours"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="rejection_reason" invisible="state != 'rejected'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hours_log" model="ir.actions.act_window">
        <field name="name">Hours Log</field>
        <field name="res_model">usbea.volunteer.hours_log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
