<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_opportunity_list" model="ir.ui.view">
        <field name="name">usbea.volunteer.opportunity.list</field>
        <field name="model">usbea.volunteer.opportunity</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'filled'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="program_id"/>
                <field name="weekday"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="starts_on"/>
                <field name="requires_background_check" widget="boolean_toggle"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_opportunity_form" model="ir.ui.view">
        <field name="name">usbea.volunteer.opportunity.form</field>
        <field name="model">usbea.volunteer.opportunity</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_rank_volunteers" type="object" string="Rank matching volunteers"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="program_id"/>
                            <field name="weekday"/>
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                        </group>
                        <group>
                            <field name="starts_on"/>
                            <field name="ends_on"/>
                            <field name="requires_background_check"/>
                        </group>
                    </group>
                    <field name="required_skill_ids" widget="many2many_tags"/>
                    <field name="description"/>
                    <field name="assigned_volunteer_ids" widget="many2many_tags"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_opportunity" model="ir.actions.act_window">
        <field name="name">Opportunities</field>
        <field name="res_model">usbea.volunteer.opportunity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
