<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_usbea_volunteers" model="ir.module.category">
            <field name="name">USBEA Volunteers</field>
            <field name="sequence">72</field>
        </record>

        <record id="group_volunteers_coordinator" model="res.groups">
            <field name="name">USBEA Volunteers / Coordinator</field>
            <field name="category_id" ref="module_category_usbea_volunteers"/>
        </record>

        <record id="group_volunteers_manager" model="res.groups">
            <field name="name">USBEA Volunteers / Manager</field>
            <field name="category_id" ref="module_category_usbea_volunteers"/>
            <field name="implied_ids" eval="[(4, ref('group_volunteers_coordinator'))]"/>
        </record>

        <record id="rule_bg_check_company" model="ir.rule">
            <field name="name">Background check: company-scoped</field>
            <field name="model_id" ref="model_usbea_volunteer_background_check"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hours_log_company" model="ir.rule">
            <field name="name">Hours log: company-scoped</field>
            <field name="model_id" ref="model_usbea_volunteer_hours_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_opportunity_company" model="ir.rule">
            <field name="name">Opportunity: company-scoped</field>
            <field name="model_id" ref="model_usbea_volunteer_opportunity"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
