<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oscip_status_form" model="ir.ui.view">
        <field name="name">usbea.oscip.status.form</field>
        <field name="model">usbea.oscip.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="is_certified"/>
                            <field name="upf_certified"/>
                        </group>
                        <group>
                            <field name="granted_at"/>
                            <field name="granted_by"/>
                            <field name="renewed_until"/>
                        </group>
                    </group>
                    <field name="qualifying_finalities" widget="many2many_tags"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oscip_status" model="ir.actions.act_window">
        <field name="name">OSCIP Status</field>
        <field name="res_model">usbea.oscip.status</field>
        <field name="view_mode">form,list</field>
    </record>
</odoo>
