<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lgpd_consent_list" model="ir.ui.view">
        <field name="name">usbea.lgpd.consent.list</field>
        <field name="model">usbea.lgpd.consent</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'revoked'" decoration-warning="state == 'expired'">
                <field name="partner_id"/>
                <field name="scope"/>
                <field name="lawful_basis"/>
                <field name="granted_at"/>
                <field name="granted_via"/>
                <field name="expires_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_lgpd_consent_form" model="ir.ui.view">
        <field name="name">usbea.lgpd.consent.form</field>
        <field name="model">usbea.lgpd.consent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="scope"/>
                            <field name="lawful_basis"/>
                            <field name="granted_via"/>
                        </group>
                        <group>
                            <field name="granted_at"/>
                            <field name="granted_by"/>
                            <field name="expires_at"/>
                            <field name="revoked_at" readonly="state != 'revoked'"/>
                            <field name="revoked_reason" readonly="state != 'revoked'"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Internal notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lgpd_consent" model="ir.actions.act_window">
        <field name="name">LGPD Consents</field>
        <field name="res_model">usbea.lgpd.consent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
