<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lgpd_dsar_kanban" model="ir.ui.view">
        <field name="name">usbea.lgpd.dsar.kanban</field>
        <field name="model">usbea.lgpd.dsar</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_type"/>
                <field name="sla_status_indicator"/>
                <field name="sla_days_remaining"/>
                <field name="received_at"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div><field name="request_type"/></div>
                            <div>SLA: <field name="sla_days_remaining"/> days</div>
                            <div>
                                <span t-attf-class="badge text-bg-#{record.sla_status_indicator.raw_value == 'red' ? 'danger' : (record.sla_status_indicator.raw_value == 'yellow' ? 'warning' : (record.sla_status_indicator.raw_value == 'overdue' ? 'danger' : 'success'))}">
                                    <field name="sla_status_indicator"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_lgpd_dsar_list" model="ir.ui.view">
        <field name="name">usbea.lgpd.dsar.list</field>
        <field name="model">usbea.lgpd.dsar</field>
        <field name="arch" type="xml">
            <list decoration-danger="sla_status_indicator in ('red', 'overdue')" decoration-warning="sla_status_indicator == 'yellow'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_type"/>
                <field name="received_at"/>
                <field name="sla_deadline"/>
                <field name="sla_days_remaining"/>
                <field name="sla_status_indicator"/>
                <field name="state"/>
                <field name="assigned_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_lgpd_dsar_form" model="ir.ui.view">
        <field name="name">usbea.lgpd.dsar.form</field>
        <field name="model">usbea.lgpd.dsar</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_processing" type="object" string="Start processing" class="btn-primary" invisible="state != 'received'"/>
                    <button name="action_fulfill" type="object" string="Fulfill" class="btn-primary" invisible="state not in ('received', 'processing')"/>
                    <button name="action_deny" type="object" string="Deny" invisible="state not in ('received', 'processing')"/>
                    <button name="action_withdraw" type="object" string="Withdraw" invisible="state in ('fulfilled', 'denied', 'withdrawn')"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,processing,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="request_type"/>
                            <field name="received_via"/>
                            <field name="received_at"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="sla_deadline" readonly="1"/>
                            <field name="sla_days_remaining" readonly="1"/>
                            <field name="sla_status_indicator" readonly="1" widget="badge"/>
                            <field name="fulfilled_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Denied reason" invisible="state != 'denied'">
                            <field name="denied_reason"/>
                        </page>
                        <page string="Aggregated data (snapshot at fulfillment)" invisible="not aggregated_data">
                            <field name="aggregated_data" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lgpd_dsar" model="ir.actions.act_window">
        <field name="name">LGPD DSARs</field>
        <field name="res_model">usbea.lgpd.dsar</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
