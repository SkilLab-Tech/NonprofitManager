<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_draft_version_form" model="ir.ui.view">
        <field name="name">usbea.grant_application.draft_version.form</field>
        <field name="model">usbea.grant_application.draft_version</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="application_id"/>
                            <field name="version_num"/>
                            <field name="section"/>
                        </group>
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="ai_assisted"/>
                            <field name="ai_suggestion_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="content" widget="text" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
