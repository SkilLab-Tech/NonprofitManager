<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_usbea_grants_seeking" model="ir.module.category">
            <field name="name">USBEA Grants Seeking</field>
            <field name="sequence">70</field>
        </record>

        <record id="group_grants_seeking_user" model="res.groups">
            <field name="name">USBEA Grants Seeking / Writer</field>
            <field name="category_id" ref="module_category_usbea_grants_seeking"/>
            <field name="comment">Can manage applications and drafts. Cannot delete versions.</field>
        </record>

        <record id="group_grants_seeking_manager" model="res.groups">
            <field name="name">USBEA Grants Seeking / Manager</field>
            <field name="category_id" ref="module_category_usbea_grants_seeking"/>
            <field name="implied_ids" eval="[(4, ref('group_grants_seeking_user'))]"/>
            <field name="comment">Can transition to terminal states (award/decline) and delete versions.</field>
        </record>

        <record id="rule_grant_application_company" model="ir.rule">
            <field name="name">Grant application: company-scoped</field>
            <field name="model_id" ref="model_usbea_grant_application"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
