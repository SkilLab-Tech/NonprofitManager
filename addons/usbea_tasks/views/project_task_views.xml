<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the stock project.task form with USBEA fields. -->
    <record id="view_project_task_form_usbea" model="ir.ui.view">
        <field name="name">project.task.form.usbea</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="usbea_template_id"
                       options="{'no_create': True, 'no_open': False}"/>
                <field name="usbea_template_category" invisible="1"/>
                <field name="grant_id" options="{'no_create_edit': True}"/>
                <field name="program_id" options="{'no_create_edit': True}"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_apply_template" type="object"
                        string="Apply template"
                        invisible="not usbea_template_id"
                        class="btn-secondary"/>
                <button name="action_compute_ai_priority" type="object"
                        string="AI priority"
                        class="btn-secondary"
                        groups="usbea_ai.group_usbea_ai_user"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="AI signals" groups="usbea_ai.group_usbea_ai_user"
                       invisible="not usbea_priority_ai_suggestion_id">
                    <field name="usbea_priority_ai"/>
                    <field name="usbea_priority_ai_reason"/>
                    <field name="usbea_priority_ai_suggestion_id"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Extend the task search view with USBEA filters. -->
    <record id="view_project_task_search_usbea" model="ir.ui.view">
        <field name="name">project.task.search.usbea</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <field name="grant_id"/>
                <field name="program_id"/>
                <field name="usbea_template_category"/>
                <filter name="my_week" string="My week" domain="[('is_in_my_week', '=', True)]"/>
                <filter name="ai_high_priority" string="AI high priority (≥70)"
                        domain="[('usbea_priority_ai', '>=', 70)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_template_category" string="Template category"
                            context="{'group_by': 'usbea_template_category'}"/>
                    <filter name="group_grant" string="Grant" context="{'group_by': 'grant_id'}"/>
                    <filter name="group_program" string="Program" context="{'group_by': 'program_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
