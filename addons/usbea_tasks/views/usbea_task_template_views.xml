<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_usbea_task_template_list" model="ir.ui.view">
        <field name="name">usbea.task.template.list</field>
        <field name="model">usbea.task.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="technical_key"/>
                <field name="category"/>
                <field name="default_assignee_role"/>
                <field name="default_due_offset_days"/>
                <field name="default_priority"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_usbea_task_template_form" model="ir.ui.view">
        <field name="name">usbea.task.template.form</field>
        <field name="model">usbea.task.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Lançamento de programa"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="technical_key" placeholder="tpl_my_template"/>
                            <field name="category"/>
                            <field name="default_assignee_role"/>
                        </group>
                        <group>
                            <field name="default_due_offset_days"/>
                            <field name="default_priority"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="due_offset_days"/>
                                    <field name="description" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_usbea_task_template" model="ir.actions.act_window">
        <field name="name">Task Templates</field>
        <field name="res_model">usbea.task.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
