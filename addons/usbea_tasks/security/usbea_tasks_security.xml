<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_usbea_tasks" model="ir.module.category">
            <field name="name">USBEA Tasks</field>
            <field name="sequence">62</field>
        </record>

        <record id="group_usbea_tasks_user" model="res.groups">
            <field name="name">USBEA Tasks / User</field>
            <field name="category_id" ref="module_category_usbea_tasks"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="group_usbea_tasks_manager" model="res.groups">
            <field name="name">USBEA Tasks / Manager</field>
            <field name="category_id" ref="module_category_usbea_tasks"/>
            <field name="implied_ids" eval="[(4, ref('group_usbea_tasks_user')), (4, ref('project.group_project_manager'))]"/>
        </record>

    </data>
</odoo>
