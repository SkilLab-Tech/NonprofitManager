<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_p2p_campaign_list" model="ir.ui.view">
        <field name="name">usbea.donation.p2p_campaign.list</field>
        <field name="model">usbea.donation.p2p_campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="host_partner_id"/>
                <field name="slug"/>
                <field name="target_amount"/>
                <field name="current_amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_p2p_campaign_form" model="ir.ui.view">
        <field name="name">usbea.donation.p2p_campaign.form</field>
        <field name="model">usbea.donation.p2p_campaign</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="host_partner_id"/>
                            <field name="slug"/>
                            <field name="target_amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="state"/>
                            <field name="current_amount" readonly="1"/>
                            <field name="progress_pct" widget="progressbar" readonly="1"/>
                        </group>
                    </group>
                    <field name="description_html"/>
                    <notebook>
                        <page string="Donations">
                            <field name="donation_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_p2p_campaign" model="ir.actions.act_window">
        <field name="name">P2P Campaigns</field>
        <field name="res_model">usbea.donation.p2p_campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
