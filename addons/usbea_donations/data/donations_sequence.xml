<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_donation" model="ir.sequence">
            <field name="name">USBEA Donation</field>
            <field name="code">usbea.donation</field>
            <field name="prefix">DON/%(year)s/</field>
            <field name="padding">6</field>
        </record>

        <record id="seq_recurring_plan" model="ir.sequence">
            <field name="name">USBEA Recurring Plan</field>
            <field name="code">usbea.donation.recurring_plan</field>
            <field name="prefix">RP/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
