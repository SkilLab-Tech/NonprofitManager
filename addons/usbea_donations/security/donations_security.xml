<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_usbea_donations" model="ir.module.category">
            <field name="name">USBEA Donations</field>
            <field name="sequence">78</field>
        </record>

        <record id="group_donations_user" model="res.groups">
            <field name="name">USBEA Donations / User</field>
            <field name="category_id" ref="module_category_usbea_donations"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_donations_manager" model="res.groups">
            <field name="name">USBEA Donations / Manager</field>
            <field name="category_id" ref="module_category_usbea_donations"/>
            <field name="implied_ids" eval="[(4, ref('group_donations_user')), (4, ref('account.group_account_manager'))]"/>
        </record>

        <record id="rule_donation_company" model="ir.rule">
            <field name="name">Donation: company-scoped</field>
            <field name="model_id" ref="model_usbea_donation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_recurring_plan_company" model="ir.rule">
            <field name="name">Recurring plan: company-scoped</field>
            <field name="model_id" ref="model_usbea_donation_recurring_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_p2p_campaign_company" model="ir.rule">
            <field name="name">P2P campaign: company-scoped</field>
            <field name="model_id" ref="model_usbea_donation_p2p_campaign"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
