<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- USBEA Platform Settings Page                 -->
    <!-- Adds a new app section in Odoo Settings      -->
    <!-- ============================================ -->
    <record id="res_config_settings_view_form_usbea" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.usbea.whitelabel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="USBEA Platform" string="USBEA Platform"
                     name="usbea_platform"
                     groups="usbea_rbac.group_platform_org_admin">

                    <!-- ============================== -->
                    <!-- Organization Profile Section   -->
                    <!-- ============================== -->
                    <div id="usbea_org_profile">
                        <block title="Organization Profile" name="org_profile_container">
                            <setting id="org_logo_setting" string="Organization Logo"
                                     help="Upload your organization's logo. This appears on reports, dashboards, and the login page.">
                                <div class="mt-3">
                                    <label for="company_id" string="Current Organization"/>
                                    <field name="company_id" readonly="1" class="w-50"/>
                                </div>
                            </setting>
                            <setting id="org_info_setting" string="Organization Info"
                                     help="Basic information about your organization.">
                                <div class="row mt-3">
                                    <label for="organization_type" class="col-lg-3 o_light_label"/>
                                    <field name="organization_type" class="w-50"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="organization_size" class="col-lg-3 o_light_label"/>
                                    <field name="organization_size" class="w-50"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="founded_year" class="col-lg-3 o_light_label"/>
                                    <field name="founded_year" class="w-50"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="legal_name" class="col-lg-3 o_light_label"/>
                                    <field name="legal_name" class="w-50"
                                           placeholder="Full legal entity name"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="tax_id_number" class="col-lg-3 o_light_label"/>
                                    <field name="tax_id_number" class="w-50"
                                           placeholder="e.g., EIN or CNPJ"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="registration_number" class="col-lg-3 o_light_label"/>
                                    <field name="registration_number" class="w-50"/>
                                </div>
                            </setting>
                            <setting id="org_mission_setting" string="Mission &amp; Description"
                                     help="Your organization's mission and public description.">
                                <div class="mt-3">
                                    <label for="mission_statement"/>
                                    <field name="mission_statement"
                                           placeholder="Enter your organization's mission statement..."/>
                                </div>
                                <div class="mt-3">
                                    <label for="organization_description"/>
                                    <field name="organization_description"
                                           placeholder="Describe your organization for public display..."/>
                                </div>
                            </setting>
                        </block>
                    </div>

                    <!-- ============================== -->
                    <!-- Contact Information Section    -->
                    <!-- ============================== -->
                    <div id="usbea_contact_info">
                        <block title="Contact Information" name="contact_info_container">
                            <setting id="contact_primary_setting" string="Primary Contact"
                                     help="Main contact details displayed on your public profile.">
                                <div class="row mt-3">
                                    <label for="contact_email_public" class="col-lg-3 o_light_label"/>
                                    <field name="contact_email_public" class="w-50"
                                           placeholder="info@yourorg.org"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="contact_phone_public" class="col-lg-3 o_light_label"/>
                                    <field name="contact_phone_public" class="w-50"
                                           placeholder="+55 11 1234-5678"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="public_website" class="col-lg-3 o_light_label"/>
                                    <field name="public_website" class="w-50" widget="url"
                                           placeholder="https://yourorg.org"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="support_email" class="col-lg-3 o_light_label"/>
                                    <field name="support_email" class="w-50"
                                           placeholder="support@yourorg.org"/>
                                </div>
                            </setting>
                            <setting id="contact_address_setting" string="Display Address"
                                     help="Address shown on reports and public pages.">
                                <div class="mt-3">
                                    <field name="address_display"
                                           placeholder="123 Main Street&#10;Suite 100&#10;Sao Paulo, SP 01310-100&#10;Brazil"/>
                                </div>
                            </setting>
                        </block>
                    </div>

                    <!-- ============================== -->
                    <!-- Social Media Section           -->
                    <!-- ============================== -->
                    <div id="usbea_social_media">
                        <block title="Social Media" name="social_media_container">
                            <setting id="social_media_setting" string="Social Media Links"
                                     help="Your organization's social media profiles.">
                                <div class="row mt-3">
                                    <label for="social_facebook" class="col-lg-3 o_light_label"/>
                                    <field name="social_facebook" class="w-50" widget="url"
                                           placeholder="https://facebook.com/yourorg"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="social_instagram" class="col-lg-3 o_light_label"/>
                                    <field name="social_instagram" class="w-50" widget="url"
                                           placeholder="https://instagram.com/yourorg"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="social_linkedin" class="col-lg-3 o_light_label"/>
                                    <field name="social_linkedin" class="w-50" widget="url"
                                           placeholder="https://linkedin.com/company/yourorg"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="social_twitter" class="col-lg-3 o_light_label"/>
                                    <field name="social_twitter" class="w-50" widget="url"
                                           placeholder="https://twitter.com/yourorg"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="social_youtube" class="col-lg-3 o_light_label"/>
                                    <field name="social_youtube" class="w-50" widget="url"
                                           placeholder="https://youtube.com/@yourorg"/>
                                </div>
                            </setting>
                        </block>
                    </div>

                    <!-- ============================== -->
                    <!-- Branding / Theme Section       -->
                    <!-- ============================== -->
                    <div id="usbea_branding">
                        <block title="Branding &amp; Theme" name="branding_container">
                            <setting id="brand_colors_setting" string="Brand Colors"
                                     help="Customize your organization's color scheme.">
                                <div class="row mt-3">
                                    <label for="brand_primary_color" class="col-lg-3 o_light_label"/>
                                    <field name="brand_primary_color" widget="color" class="w-25"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="brand_secondary_color" class="col-lg-3 o_light_label"/>
                                    <field name="brand_secondary_color" widget="color" class="w-25"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="brand_accent_color" class="col-lg-3 o_light_label"/>
                                    <field name="brand_accent_color" widget="color" class="w-25"/>
                                </div>
                            </setting>
                            <setting id="brand_font_setting" string="Font"
                                     help="Choose the font used across the platform.">
                                <div class="row mt-3">
                                    <label for="brand_font" class="col-lg-3 o_light_label"/>
                                    <field name="brand_font" class="w-50"/>
                                </div>
                            </setting>
                            <setting id="brand_favicon_setting" string="Favicon"
                                     help="Browser tab icon (32x32 pixels recommended).">
                                <div class="mt-3">
                                    <field name="favicon" widget="image" class="oe_avatar"/>
                                </div>
                            </setting>
                        </block>
                    </div>

                    <!-- ============================== -->
                    <!-- Reports & Portal Section       -->
                    <!-- ============================== -->
                    <div id="usbea_reports">
                        <block title="Reports &amp; Portal" name="reports_portal_container">
                            <setting id="report_footer_setting" string="Report Footer"
                                     help="Custom text displayed at the bottom of all PDF reports.">
                                <div class="mt-3">
                                    <field name="report_footer_text"
                                           placeholder="e.g., USBEA Brasil | Tax ID: XX.XXX.XXX/0001-XX | www.usbea.org"/>
                                </div>
                            </setting>
                            <setting id="portal_welcome_setting" string="Welcome Message"
                                     help="Message shown to users after login.">
                                <div class="mt-3">
                                    <field name="portal_welcome_message"
                                           placeholder="Welcome to our organization's management platform..."/>
                                </div>
                            </setting>
                        </block>
                    </div>

                    <!-- ============================== -->
                    <!-- Feature Toggles Section        -->
                    <!-- ============================== -->
                    <div id="usbea_features">
                        <block title="Enabled Modules" name="features_container">
                            <setting id="feature_grants_setting"
                                     string="Grant Management"
                                     help="Track grants, budgets, expenses, and compliance.">
                                <field name="show_grants_module"/>
                            </setting>
                            <setting id="feature_programs_setting"
                                     string="Program Management"
                                     help="Manage exchange programs, participants, and visa tracking.">
                                <field name="show_programs_module"/>
                            </setting>
                            <setting id="feature_expenses_setting"
                                     string="Expense Tracking"
                                     help="Track expenses with grant and program allocation.">
                                <field name="show_expenses_module"/>
                            </setting>
                            <setting id="feature_compliance_setting"
                                     string="Compliance Reporting"
                                     help="Generate funder compliance reports.">
                                <field name="show_compliance_module"/>
                            </setting>
                            <setting id="feature_board_setting"
                                     string="Board Portal"
                                     help="Read-only dashboard for board members and donors.">
                                <field name="show_board_portal"/>
                            </setting>
                        </block>
                    </div>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
