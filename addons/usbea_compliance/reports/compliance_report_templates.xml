<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- 1. Quarterly Narrative Report                -->
    <!-- ============================================ -->
    <record id="action_report_quarterly_narrative" model="ir.actions.report">
        <field name="name">Quarterly Narrative Report</field>
        <field name="model">usbea.grant.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">usbea_compliance.report_quarterly_narrative</field>
        <field name="report_file">usbea_compliance.report_quarterly_narrative</field>
        <field name="binding_model_id" ref="usbea_grants.model_usbea_grant_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_quarterly_narrative">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>USBEA Brasil</h2>
                            <h3>Quarterly Narrative Report</h3>
                            <hr/>
                        </div>

                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td width="30%"><strong>Grant:</strong></td>
                                    <td><t t-out="report.grant_id.name"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Grant Number:</strong></td>
                                    <td><t t-out="report.grant_id.grant_number"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Funder:</strong></td>
                                    <td><t t-out="report.grant_id.funding_source.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Reporting Period:</strong></td>
                                    <td>
                                        <t t-out="report.period_start"/> to <t t-out="report.period_end"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Report Date:</strong></td>
                                    <td><t t-out="report.submission_date or 'Not yet submitted'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Prepared By:</strong></td>
                                    <td><t t-out="report.submitted_by.name or report.grant_id.responsible_id.name or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">1. Executive Summary</h4>
                        <div class="border p-3 mb-3">
                            <t t-if="report.narrative">
                                <t t-out="report.narrative"/>
                            </t>
                            <t t-else="">
                                <p class="text-muted">[To be completed]</p>
                            </t>
                        </div>

                        <h4>2. Financial Summary</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Approved Grant Amount</td>
                                    <td class="text-end">
                                        <t t-out="report.grant_id.approved_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': report.grant_id.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Total Disbursed</td>
                                    <td class="text-end">
                                        <t t-out="report.grant_id.disbursed_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': report.grant_id.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Total Spent to Date</td>
                                    <td class="text-end">
                                        <t t-out="report.grant_id.spent_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': report.grant_id.currency_id}"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Remaining Balance</td>
                                    <td class="text-end">
                                        <t t-out="report.grant_id.remaining_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': report.grant_id.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Utilization Rate</td>
                                    <td class="text-end">
                                        <t t-out="'%.1f' % report.grant_id.utilization_rate"/>%
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Budget Breakdown -->
                        <t t-if="report.grant_id.budget_ids">
                            <h4 class="mt-4">3. Budget vs Actual Spending</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Budgeted</th>
                                        <th class="text-end">Spent</th>
                                        <th class="text-end">Variance</th>
                                        <th class="text-end">% Used</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="report.grant_id.budget_ids" t-as="budget">
                                        <tr>
                                            <td><t t-out="budget.name"/></td>
                                            <td class="text-end">
                                                <t t-out="budget.planned_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': report.grant_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.actual_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': report.grant_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.variance"
                                                   t-options="{'widget': 'monetary', 'display_currency': report.grant_id.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'%.1f' % (100 - budget.variance_pct) if budget.planned_amount else 0"/>%
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <h4 class="mt-4">
                            <t t-out="'4' if report.grant_id.budget_ids else '3'"/>. Detailed Financial Summary
                        </h4>
                        <div class="border p-3 mb-3">
                            <t t-if="report.financial_summary">
                                <t t-out="report.financial_summary"/>
                            </t>
                            <t t-else="">
                                <p class="text-muted">[To be completed]</p>
                            </t>
                        </div>

                        <h4>
                            <t t-out="'5' if report.grant_id.budget_ids else '4'"/>. Impact &amp; Outcomes
                        </h4>
                        <div class="border p-3 mb-3">
                            <t t-if="report.impact_metrics">
                                <t t-out="report.impact_metrics"/>
                            </t>
                            <t t-else="">
                                <p class="text-muted">[To be completed]</p>
                            </t>
                        </div>

                        <div class="mt-5 text-center">
                            <p class="text-muted">
                                This report was generated by USBEA Brasil Nonprofit Management Platform
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================ -->
    <!-- 2. Financial Expenditure Report              -->
    <!-- ============================================ -->
    <record id="action_report_financial_expenditure" model="ir.actions.report">
        <field name="name">Financial Expenditure Report</field>
        <field name="model">usbea.grant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">usbea_compliance.report_financial_expenditure</field>
        <field name="report_file">usbea_compliance.report_financial_expenditure</field>
        <field name="binding_model_id" ref="usbea_grants.model_usbea_grant"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_financial_expenditure">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="grant">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>USBEA Brasil</h2>
                            <h3>Financial Expenditure Report</h3>
                            <hr/>
                        </div>

                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td width="30%"><strong>Grant:</strong></td>
                                    <td><t t-out="grant.name"/> (<t t-out="grant.grant_number"/>)</td>
                                </tr>
                                <tr>
                                    <td><strong>Funder:</strong></td>
                                    <td><t t-out="grant.funding_source.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Project Period:</strong></td>
                                    <td><t t-out="grant.start_date"/> to <t t-out="grant.end_date"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Summary</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>Approved Amount</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.approved_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Total Expenditures</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.spent_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold border-top">
                                    <td>Remaining Balance</td>
                                    <td class="text-end">
                                        <t t-out="grant.remaining_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Approved Expenses Detail -->
                        <h4 class="mt-4">Detailed Expenditures</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>Vendor</th>
                                    <th>Reference</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total" t-value="0"/>
                                <t t-foreach="grant.expense_ids.filtered(lambda e: e.state == 'approved').sorted(key=lambda e: e.date)" t-as="expense">
                                    <t t-set="total" t-value="total + expense.amount"/>
                                    <tr>
                                        <td><t t-out="expense.date"/></td>
                                        <td><t t-out="expense.name"/></td>
                                        <td><t t-out="dict(expense._fields['category'].selection).get(expense.category)"/></td>
                                        <td><t t-out="expense.vendor or '-'"/></td>
                                        <td><t t-out="expense.reference or '-'"/></td>
                                        <td class="text-end">
                                            <t t-out="expense.amount"
                                               t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="fw-bold border-top">
                                    <td colspan="5">Total</td>
                                    <td class="text-end">
                                        <t t-out="total"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Budget vs Actual -->
                        <t t-if="grant.budget_ids">
                            <h4 class="mt-4">Budget vs Actual</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Budgeted</th>
                                        <th class="text-end">Actual</th>
                                        <th class="text-end">Variance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="grant.budget_ids" t-as="budget">
                                        <tr>
                                            <td><t t-out="budget.name"/></td>
                                            <td class="text-end">
                                                <t t-out="budget.planned_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.actual_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.variance"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <div class="mt-5">
                            <div class="row">
                                <div class="col-6">
                                    <p>Prepared by: ___________________________</p>
                                    <p>Date: ___________________________</p>
                                </div>
                                <div class="col-6">
                                    <p>Approved by: ___________________________</p>
                                    <p>Date: ___________________________</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 text-center">
                            <p class="text-muted">
                                USBEA Brasil Nonprofit Management Platform
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================ -->
    <!-- 3. Participant Impact Report                 -->
    <!-- ============================================ -->
    <record id="action_report_participant_impact" model="ir.actions.report">
        <field name="name">Participant Impact Report</field>
        <field name="model">usbea.program</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">usbea_compliance.report_participant_impact</field>
        <field name="report_file">usbea_compliance.report_participant_impact</field>
        <field name="binding_model_id" ref="usbea_programs.model_usbea_program"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_participant_impact">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="program">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>USBEA Brasil</h2>
                            <h3>Participant Impact Report</h3>
                            <hr/>
                        </div>

                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td width="30%"><strong>Program:</strong></td>
                                    <td><t t-out="program.name"/> (<t t-out="program.program_code"/>)</td>
                                </tr>
                                <tr>
                                    <td><strong>Type:</strong></td>
                                    <td><t t-out="dict(program._fields['program_type'].selection).get(program.program_type)"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Period:</strong></td>
                                    <td><t t-out="program.start_date"/> to <t t-out="program.end_date"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Coordinator:</strong></td>
                                    <td><t t-out="program.responsible_id.name or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Participation Summary</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>Total Participants</strong></td>
                                    <td><t t-out="len(program.participant_ids)"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Active</strong></td>
                                    <td><t t-out="len(program.participant_ids.filtered(lambda p: p.state == 'active'))"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Completed</strong></td>
                                    <td><t t-out="len(program.participant_ids.filtered(lambda p: p.state == 'completed'))"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Withdrawn</strong></td>
                                    <td><t t-out="len(program.participant_ids.filtered(lambda p: p.state == 'withdrawn'))"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Participant Roster</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>City</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="0"/>
                                <t t-foreach="program.participant_ids.sorted(key=lambda p: p.name)" t-as="participant">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <tr>
                                        <td><t t-out="counter"/></td>
                                        <td><t t-out="participant.name"/></td>
                                        <td><t t-out="dict(participant._fields['role'].selection).get(participant.role)"/></td>
                                        <td><t t-out="participant.city or '-'"/></td>
                                        <td><t t-out="dict(participant._fields['state'].selection).get(participant.state)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Events Summary -->
                        <t t-if="program.event_ids">
                            <h4 class="mt-4">Program Events</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Type</th>
                                        <th>Date</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="program.event_ids.sorted(key=lambda e: e.date_start)" t-as="event">
                                        <tr>
                                            <td><t t-out="event.name"/></td>
                                            <td><t t-out="dict(event._fields['event_type'].selection).get(event.event_type)"/></td>
                                            <td><t t-out="event.date_start"/></td>
                                            <td><t t-out="event.location or '-'"/></td>
                                            <td><t t-out="dict(event._fields['state'].selection).get(event.state)"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <div class="mt-5 text-center">
                            <p class="text-muted">
                                USBEA Brasil Nonprofit Management Platform
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================ -->
    <!-- 4. Grant Closeout Report                     -->
    <!-- ============================================ -->
    <record id="action_report_grant_closeout" model="ir.actions.report">
        <field name="name">Grant Closeout Report</field>
        <field name="model">usbea.grant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">usbea_compliance.report_grant_closeout</field>
        <field name="report_file">usbea_compliance.report_grant_closeout</field>
        <field name="binding_model_id" ref="usbea_grants.model_usbea_grant"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_grant_closeout">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="grant">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>USBEA Brasil</h2>
                            <h3>Final Grant Closeout Report</h3>
                            <hr/>
                        </div>

                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td width="30%"><strong>Grant:</strong></td>
                                    <td><t t-out="grant.name"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Grant Number:</strong></td>
                                    <td><t t-out="grant.grant_number"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Funder:</strong></td>
                                    <td><t t-out="grant.funding_source.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Grant Type:</strong></td>
                                    <td><t t-out="dict(grant._fields['grant_type'].selection).get(grant.grant_type)"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Project Period:</strong></td>
                                    <td><t t-out="grant.start_date"/> to <t t-out="grant.end_date"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Grant Manager:</strong></td>
                                    <td><t t-out="grant.responsible_id.name or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">1. Financial Closeout</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>Original Approved Amount</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.approved_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Total Disbursements Received</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.disbursed_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Total Expenditures</strong></td>
                                    <td class="text-end">
                                        <t t-out="grant.spent_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold border-top">
                                    <td>Unexpended Balance</td>
                                    <td class="text-end">
                                        <t t-out="grant.remaining_amount"
                                           t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Final Utilization Rate</strong></td>
                                    <td class="text-end">
                                        <t t-out="'%.1f' % grant.utilization_rate"/>%
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Budget Comparison -->
                        <t t-if="grant.budget_ids">
                            <h4 class="mt-4">2. Final Budget Comparison</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Original Budget</th>
                                        <th class="text-end">Final Expenditure</th>
                                        <th class="text-end">Variance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="total_planned" t-value="0"/>
                                    <t t-set="total_actual" t-value="0"/>
                                    <t t-foreach="grant.budget_ids" t-as="budget">
                                        <t t-set="total_planned" t-value="total_planned + budget.planned_amount"/>
                                        <t t-set="total_actual" t-value="total_actual + budget.actual_amount"/>
                                        <tr>
                                            <td><t t-out="budget.name"/></td>
                                            <td class="text-end">
                                                <t t-out="budget.planned_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.actual_amount"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="budget.variance"
                                                   t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="fw-bold border-top">
                                        <td>TOTAL</td>
                                        <td class="text-end">
                                            <t t-out="total_planned"
                                               t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-out="total_actual"
                                               t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-out="total_planned - total_actual"
                                               t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <h4 class="mt-4">3. Disbursement History</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Tranche</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="grant.disbursement_ids.filtered(lambda d: d.state == 'confirmed').sorted(key=lambda d: d.date)" t-as="disb">
                                    <tr>
                                        <td><t t-out="disb.date"/></td>
                                        <td><t t-out="disb.name"/></td>
                                        <td><t t-out="disb.tranche_number"/></td>
                                        <td class="text-end">
                                            <t t-out="disb.amount"
                                               t-options="{'widget': 'monetary', 'display_currency': grant.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4 class="mt-4">4. Compliance Reports Submitted</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Report</th>
                                    <th>Type</th>
                                    <th>Due Date</th>
                                    <th>Submitted</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="grant.report_ids.sorted(key=lambda r: r.due_date)" t-as="report">
                                    <tr>
                                        <td><t t-out="report.name"/></td>
                                        <td><t t-out="dict(report._fields['report_type'].selection).get(report.report_type)"/></td>
                                        <td><t t-out="report.due_date"/></td>
                                        <td><t t-out="report.submission_date or '-'"/></td>
                                        <td><t t-out="dict(report._fields['state'].selection).get(report.state)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="mt-5">
                            <h4>5. Certification</h4>
                            <p>I certify that the information provided in this closeout report is accurate
                               and complete to the best of my knowledge, and that all grant funds have been
                               expended in accordance with the terms and conditions of the grant agreement.</p>
                            <div class="row mt-4">
                                <div class="col-6">
                                    <p>Grant Manager: ___________________________</p>
                                    <p>Signature: ___________________________</p>
                                    <p>Date: ___________________________</p>
                                </div>
                                <div class="col-6">
                                    <p>Executive Director: ___________________________</p>
                                    <p>Signature: ___________________________</p>
                                    <p>Date: ___________________________</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 text-center">
                            <p class="text-muted">
                                USBEA Brasil Nonprofit Management Platform
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
